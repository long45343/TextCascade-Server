[Unit]
Description=TextCascade lightweight text synchronization server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/textcascade-server
EnvironmentFile=/etc/textcascade/textcascade.env
ExecStart=/usr/bin/dotnet /opt/textcascade-server/TextCascade.Server.dll serve --config /etc/textcascade/textcascade.toml
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=textcascade-server

[Install]
WantedBy=multi-user.target
